FROM node:22-bookworm-slim
WORKDIR /app
COPY server/duelist/package.json ./server/duelist/package.json
RUN npm install --prefix server/duelist --omit=dev --ignore-scripts --no-audit --no-fund
COPY server/duelist ./server/duelist
COPY src/components/duelist ./src/components/duelist
USER node
EXPOSE 5321
CMD ["node","server/duelist/publicHostEntry.mjs"]
