{
  "name": "Game3DGuestCharacterSave",
  "type": "object",
  "description": "Private passwordless Game 3D guest save. Only the guestCharacterVault server function reads or writes records after verifying the recovery code. Never expose these records directly to visitors.",
  "properties": {
    "character_id": { "type": "string", "maxLength": 128 },
    "name_key": { "type": "string", "maxLength": 24 },
    "name": { "type": "string", "maxLength": 24 },
    "recovery_hash": { "type": "string", "description": "SHA-256 of a cryptographically random 160-bit recovery code; never store plaintext" },
    "revision": { "type": "integer", "minimum": 0 },
    "data": { "type": "object" },
    "fingerprint": { "type": "string" },
    "roster_entry": { "type": "object" },
    "saved_at": { "type": "string", "format": "date-time" },
    "previous_data": { "type": "object", "description": "Last good snapshot to preserve against accidental overwrites" },
    "previous_revision": { "type": "integer", "minimum": 0 },
    "deleted_at": { "type": "string", "format": "date-time" }
  },
  "required": ["character_id", "name_key", "name", "recovery_hash", "revision", "data"],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
