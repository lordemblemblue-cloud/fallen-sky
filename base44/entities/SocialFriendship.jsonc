{
  "name": "SocialFriendship",
  "type": "object",
  "properties": {
    "user_a_id": {
      "type": "string",
      "description": "One side of the friendship"
    },
    "user_a_name": {
      "type": "string",
      "description": "Display name of that side"
    },
    "user_b_id": {
      "type": "string",
      "description": "Other side of the friendship"
    },
    "user_b_name": {
      "type": "string",
      "description": "Display name of that side"
    }
  },
  "required": [
    "user_a_id",
    "user_b_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_a_id": "{{user.id}}"
        },
        {
          "data.user_b_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.user_a_id": "{{user.id}}"
        },
        {
          "data.user_b_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}