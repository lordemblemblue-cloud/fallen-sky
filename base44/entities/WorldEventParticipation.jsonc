{
  "name": "WorldEventParticipation",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Account this participation row belongs to"
    },
    "event_id": {
      "type": "string",
      "description": "World event being tracked"
    },
    "joined_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the account joined the event"
    },
    "contribution": {
      "type": "number",
      "default": 0,
      "description": "Server-recorded contribution to the event"
    },
    "quest_progress": {
      "type": "object",
      "default": {},
      "description": "Server-recorded progress per quest: { quest_id: { progress, target, verified_at, claimed_at } }. Written only by server-side gameplay."
    }
  },
  "required": [
    "user_id",
    "event_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}