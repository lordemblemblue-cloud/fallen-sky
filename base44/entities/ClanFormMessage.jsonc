{
  "name": "ClanFormMessage",
  "type": "object",
  "properties": {
    "channel_id": {
      "type": "string",
      "description": "Parent forum channel ID, required for scoped reads and writes",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "edited_at": {
      "type": "string",
      "format": "date-time",
      "description": "Most recent successful edit time"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Soft-deletion timestamp; preserve reply positions"
    },
    "topic_id": {
      "type": "string",
      "description": "Topic this message belongs to",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "game_id": {
      "type": "string",
      "description": "Game ID this message belongs to"
    },
    "user_id": {
      "type": "string",
      "description": "Author user ID",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "clan_id": {
      "type": "string",
      "description": "Author clan ID",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "username": {
      "type": "string",
      "description": "Cached username for display",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "content": {
      "type": "string",
      "description": "Message content"
    }
  },
  "required": [
    "topic_id",
    "user_id",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}