{
  "name": "Companion",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "level": {
      "type": "number",
      "default": 1
    },
    "abilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "icon_url": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "description",
    "genre"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}