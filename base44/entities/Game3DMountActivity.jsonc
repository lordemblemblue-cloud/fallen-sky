{
  "name": "Game3DMountActivity",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "character_id": {
      "type": "string"
    },
    "companion_id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "follow",
        "fetch",
        "treasure",
        "water_play",
        "brush",
        "bond",
        "rest"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_animation",
        "ready",
        "in_progress",
        "finished",
        "cancelled"
      ]
    },
    "region": {
      "type": "string"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "animation_id": {
      "type": "string"
    },
    "quest_id": {
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "character_id",
    "companion_id",
    "action",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
