{
  "name": "GuestVaultQuota",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "register",
        "recover"
      ]
    },
    "window_start": {
      "type": "integer",
      "minimum": 0
    },
    "used": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "action",
    "window_start",
    "used"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
