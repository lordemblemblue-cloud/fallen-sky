{
  "name": "SocialNotification",
  "type": "object",
  "properties": {
    "recipient_id": {
      "type": "string",
      "description": "User who receives this notification"
    },
    "actor_id": {
      "type": "string",
      "description": "User whose action caused it"
    },
    "actor_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "friend_request",
        "friend_accepted",
        "friend_declined"
      ],
      "description": "What happened"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "description": "Message shown in the in-game toast"
    },
    "request_id": {
      "type": "string",
      "description": "FriendRequest this notification refers to"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "recipient_id",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}