{
  "name": "ClanInvite",
  "type": "object",
  "properties": {
    "divisionId": {
      "type": "string"
    },
    "inviterId": {
      "type": "string"
    },
    "inviteeId": {
      "type": "string",
      "description": "User ID of the invited person"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "divisionId",
    "inviterId",
    "inviteeId"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.inviteeId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}