{
  "name": "AvatarHomeState",
  "type": "object",
  "properties": {
    "avatarId": {
      "type": "string",
      "description": "ID of the avatar/user this home belongs to"
    },
    "currentEnvironmentId": {
      "type": "string",
      "description": "ID of the currently selected 3D environment model"
    },
    "level": {
      "type": "number",
      "default": 1
    },
    "mood": {
      "type": "string",
      "default": "calm"
    },
    "catchphrase": {
      "type": "string",
      "default": "Welcome in. Make yourself at home."
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "games": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "vehicles": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "activityLog": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "preferences": {
      "type": "object",
      "default": {},
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "avatarId"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}