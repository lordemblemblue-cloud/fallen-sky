{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "channel_id": {
      "type": "string",
      "description": "Game channel: game3d_world or game3d_party_<partyId>"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_role": {
      "type": "string",
      "default": "member"
    },
    "content": {
      "type": "string",
      "description": "Message text, capped and cleaned by the worldChat server function"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "system"
      ],
      "default": "text"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "channel_id",
    "sender_id",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}