{
  "name": "Game3DEchoEncounter",
  "type": "object",
  "properties": {
    "initiator_id": { "type": "string" },
    "initiator_name": { "type": "string" },
    "recipient_id": { "type": "string" },
    "recipient_name": { "type": "string" },
    "status": { "type": "string", "enum": ["pending", "active", "finished", "declined", "expired"], "default": "pending" },
    "context_type": { "type": "string", "enum": ["exploration", "boss", "chance"], "default": "chance" },
    "region": { "type": "string" },
    "meeting_distance_m": { "type": "number" },
    "previous_encounters": { "type": "integer", "default": 0 },
    "previous_met_at": { "type": "string", "format": "date-time" },
    "previous_region": { "type": "string" },
    "expires_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "remembered_at": { "type": "string", "format": "date-time" },
    "consent_initiator": { "type": "boolean", "default": false },
    "consent_recipient": { "type": "boolean", "default": false },
    "adventure_proposal": {
      "type": "object",
      "properties": {
        "quest_id": { "type": "string" },
        "status": { "type": "string", "enum": ["proposed", "agreed", "declined", "withdrawn"] },
        "proposed_by": { "type": "string" },
        "proposed_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "accepted_initiator": { "type": "boolean" },
        "accepted_recipient": { "type": "boolean" }
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "speaker_id": { "type": "string" },
          "speaker_name": { "type": "string" },
          "kind": { "type": "string", "enum": ["speech", "gesture"] },
          "gesture_id": { "type": "string" },
          "text": { "type": "string" },
          "at": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "required": ["initiator_id", "recipient_id", "status"],
  "rls": {
    "read": {
      "$or": [
        { "data.initiator_id": "{{user.id}}" },
        { "data.recipient_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
