{
  "name": "Game3DDuelMastery",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "Authenticated account whose verified duel skill XP was earned on the server"
    },
    "xp": {
      "type": "object",
      "description": "Skill ID to XP; backend writes ONLY after accepted DuelSession skill hits"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": ["owner_id"],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
