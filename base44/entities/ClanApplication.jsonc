{
  "name": "ClanApplication",
  "type": "object",
  "properties": {
    "divisionId": {
      "type": "string",
      "description": "The ID of the clan being applied to"
    },
    "userId": {
      "type": "string",
      "description": "The ID of the user applying"
    },
    "message": {
      "type": "string",
      "description": "Optional message from the applicant"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "divisionId",
    "userId"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}