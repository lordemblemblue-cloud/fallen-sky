{
  "name": "ClanFormChannel",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "ID of the game this channel belongs to"
    },
    "name": {
      "type": "string",
      "description": "Channel name"
    },
    "description": {
      "type": "string",
      "description": "What this channel is for"
    },
    "created_by_clan_id": {
      "type": "string",
      "description": "Clan that created the channel"
    },
    "participating_clan_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Clans participating in this channel"
    },
    "is_open": {
      "type": "boolean",
      "default": true,
      "description": "Whether new clans can join"
    },
    "capacity": {
      "type": "number",
      "default": 50,
      "description": "Max concurrent active members"
    },
    "active_member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Users currently active in this channel"
    },
    "access_scope": {
      "type": "string",
      "enum": [
        "all_clans",
        "clan_only"
      ],
      "default": "all_clans",
      "description": "Who can join this channel"
    },
    "join_password": {
      "type": "string",
      "description": "Optional password required to join",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "channel_type": {
      "type": "string",
      "enum": [
        "chat",
        "party"
      ],
      "default": "chat",
      "description": "Channel mode/type"
    }
  },
  "required": [
    "game_id",
    "name",
    "created_by_clan_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}